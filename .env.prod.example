# Copy to `.env` ON THE SERVER ONLY (never commit it). Compose reads it
# automatically from this folder.

# Makes plain `docker compose ...` use the prod file, so nobody can
# accidentally start the dev compose (public Postgres port, default
# pgAdmin password) on this server.
COMPOSE_FILE=docker-compose.prod.yml

# Letters+digits only (e.g. `openssl rand -hex 16`) — this goes inside a
# connection URL, where characters like @ / : # would break it.
POSTGRES_PASSWORD=

# `openssl rand -hex 32`. Changing it later logs everybody out.
SECRET_KEY=

# Same secret token the backend uses for Permanent Geocoding.
MAPBOX_SECRET_TOKEN=

# Your public pk... token, for the web dashboard's maps.
MAPBOX_PUBLIC_TOKEN=

# No trailing slash. Web + API share this one origin (Nginx routes /api).
PUBLIC_URL=https://fieldforce.vorpet.com
